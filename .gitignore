# Build output
.gradle/
build/
app/build/
.kotlin/
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Local Android SDK and the installer it came from
android-sdk/
tools/prototype/cmdline-tools.zip

# Built APKs. Attach the debug build to the submission instead of committing it -
# it is 74MB and would be carried in every clone forever.
*.apk
*.aab

# The supplied test clips. They are iykyk's assignment assets, not ours to
# redistribute, and nothing in the build depends on them. Drop them in vids/
# locally to run the prototype or the on-device tests.
vids/

# Model files the prototype downloads on demand (the app's own copy of
# mobilefacenet.tflite lives in app/src/main/assets and IS tracked).
tools/prototype/models/

# Working notes. These are how the project was planned and debugged, not part
# of it - the spec, the step plan, the running progress log, the bug write-up,
# the design system and the local phone-testing steps. Kept on disk because
# they are still the reference while building; not pushed because a reader
# wants the README and the code.
prd.md
plan.md
progress.md
failures.md
design_notes.md
TESTING.md
CONTRIBUTING.md

# Design references, including iykyk's own landing page. Someone else's
# artwork, gathered for inspiration and not ours to redistribute.
design_insp/

# Python
__pycache__/
*.pyc
